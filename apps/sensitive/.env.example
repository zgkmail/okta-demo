# Sensitive App

# Must match the Baseline App's issuer -- same tenant is what makes SSO work.
AUTH0_ISSUER_BASE_URL=https://auth.littlecap.biz

# A DIFFERENT Auth0 application from the Baseline App.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# See the note in apps/baseline/.env.example -- not localhost, to avoid Auth0's
# non-verifiable-callback consent screen. Needs an /etc/hosts entry.
BASE_URL=http://sensitive.littlecap.biz:3001
PORT=3001

PEER_URL=http://baseline.littlecap.biz:3000

# Generate with: openssl rand -hex 32
# Use a different value from the Baseline App.
SESSION_SECRET=
