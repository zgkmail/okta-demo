# Baseline App

# The custom domain, verified and serving OIDC discovery. Use this rather than
# the default tenant domain (dev-brceciohbwk3emhb.us.auth0.com): passkeys bind
# to the RP ID derived from this host, so the two are not interchangeable.
AUTH0_ISSUER_BASE_URL=https://auth.littlecap.biz

AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Must exactly match the Allowed Callback URL (${BASE_URL}/callback) and
# Allowed Logout URL configured on this application in Auth0.
#
# Not localhost: Auth0 treats localhost callbacks as non-verifiable and shows a
# consent screen even for first-party apps. Needs an /etc/hosts entry mapping
# this name to 127.0.0.1.
BASE_URL=http://baseline.littlecap.biz:3000
PORT=3000

# The other app, linked from the UI to demonstrate SSO.
PEER_URL=http://sensitive.littlecap.biz:3001

# Encrypts this app's own session cookie. Generate with:
#   openssl rand -hex 32
# Use a DIFFERENT value in each app -- they are separate applications with
# separate local sessions, and sharing it would blur what SSO is actually doing.
SESSION_SECRET=
